<Window x:Class="PRJ2_Extractor.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full logs - PRJ2 Extractor"
        Width="900" Height="620" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Complete session log, including exception details and stack traces."
                   Style="{StaticResource Caption}" Margin="2,0,0,10"/>
        <TextBox x:Name="LogTextBox" Grid.Row="1" Text="{Binding FullLogText, Mode=OneWay}"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Foreground="{DynamicResource TextPrimary}"
                 Background="{DynamicResource PreviewBackground}"
                 BorderBrush="{DynamicResource CardBorder}"
                 Padding="10"
                 IsUndoEnabled="False"
                 TextChanged="LogTextBox_TextChanged"/>
    </Grid>
</Window>
