<Window x:Class="PRJ2_Extractor.LogWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full logs - PRJ2 Extractor"
        Icon="/PRJ2.ico"
        Width="900" Height="620" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        FontSize="13" UseLayoutRounding="True">
    <Grid Margin="16" RowDefinitions="Auto,*">
        <TextBlock Text="Complete session log, including exception details and stack traces." Classes="caption" Margin="2,0,0,10"/>
        <Border Grid.Row="1" Background="{DynamicResource PreviewBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="LogScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding FullLogText, Mode=OneWay}" Padding="10" TextWrapping="NoWrap"
                                     FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12"
                                     Foreground="{DynamicResource TextPrimary}"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
