<Window x:Class="PRJ2_Extractor.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="/PRJ2.ico"
        Width="1060" Height="740" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontSize="13"
        DragDrop.AllowDrop="True" UseLayoutRounding="True">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenLevelCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}"/>
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============ header ============ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="PRJ2 Extractor" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Tomb Raider 1-5, TRNG or TombEngine level to Tomb Editor project (.prj2), with textures" Classes="caption" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="{DynamicResource HoverFill}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="9" Padding="2"
                            Margin="0,0,12,0" ToolTip.Tip="Colour theme">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="System" GroupName="Theme" IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" Theme="{StaticResource ThemeChoice}"
                                         ToolTip.Tip="Follow the system's light / dark setting"/>
                            <RadioButton Content="Light" GroupName="Theme" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" Theme="{StaticResource ThemeChoice}"/>
                            <RadioButton Content="Dark" GroupName="Theme" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" Theme="{StaticResource ThemeChoice}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ content ============ -->
        <Grid Grid.Row="1" Margin="16" ColumnDefinitions="400,16,*">

            <!-- left column -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

                <!-- level -->
                <Border Grid.Row="0" Classes="card">
                    <Grid>
                        <!-- nothing opened yet -->
                        <Grid IsVisible="{Binding !HasLevel}" MinHeight="150">
                            <Rectangle Classes="dropzone" Classes.over="{Binding IsDragOver}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                <TextBlock Text="Drop a level here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text=".phd, .tr2, .tr4, .trc, .ten" Classes="caption" HorizontalAlignment="Center" Margin="0,3,0,12"/>
                                <Button Content="Open level..." Command="{Binding OpenLevelCommand}" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- level opened -->
                        <StackPanel IsVisible="{Binding HasLevel}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding LevelName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LevelFormat}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding LevelFolder}" ToolTip.Tip="{Binding LevelFolder}" Classes="caption" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Label}" Classes="caption"/>
                                            <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Open another..." Command="{Binding OpenLevelCommand}" Theme="{StaticResource SecondaryButton}"/>
                                <Button Content="Close" Command="{Binding CloseLevelCommand}" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- export -->
                <Border Grid.Row="1" Classes="card" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Export" Classes="sectiontitle"/>

                        <StackPanel IsEnabled="{Binding CanEditOutput}" Margin="0,10,0,0">
                            <TextBlock Text="Output folder" Classes="caption"/>
                            <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding OutputFolder}" Theme="{StaticResource FieldBox}"/>
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputCommand}" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Project name" Classes="caption" Margin="0,10,0,0"/>
                            <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding OutputName}" Theme="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Column="1" Text=".prj2" Classes="caption" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Text="{Binding OutputSummary, StringFormat='Writes: {0}'}" Classes="caption" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Content="Export PRJ2" Command="{Binding ExportCommand}" Theme="{StaticResource PrimaryButton}" Margin="0,14,0,0" Height="42"
                                HorizontalAlignment="Stretch"/>

                        <StackPanel Margin="0,10,0,0" IsVisible="{Binding IsBusy}">
                            <ProgressBar Classes="slim" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"/>
                            <TextBlock Text="{Binding BusyText}" Classes="caption" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button Content="Show exported project in folder" Command="{Binding ShowInFolderCommand}" Theme="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                                IsVisible="{Binding HasExport}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- activity log -->
                <Border Grid.Row="2" Classes="card" Margin="0,12,0,0" Padding="18,14,18,12">
                    <Grid RowDefinitions="Auto,*">
                        <Grid>
                            <TextBlock Text="Activity" Classes="sectiontitle" VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Content="Full logs..." Click="ShowFullLogs_Click" Theme="{StaticResource ToolButton}" Margin="0,0,6,0"/>
                                <Button Content="Clear" Command="{Binding ClearLogCommand}" Theme="{StaticResource ToolButton}"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer x:Name="LogScroller" Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5" ColumnDefinitions="16,Auto,*">
                                            <TextBlock Text="{Binding Level, Converter={StaticResource LogLevelGlyph}}" Classes="logmarker"
                                                       Classes.success="{Binding IsSuccess}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="caption" Margin="4,1,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" FontSize="12.5"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- texture preview -->
            <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,*">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Texture atlas" Classes="sectiontitle"/>
                            <TextBlock Text="{Binding TextureCaption}" Classes="caption" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#8722;" Command="{Binding ZoomOutCommand}" Theme="{StaticResource ToolButton}" ToolTip.Tip="Zoom out (Ctrl + wheel)"/>
                            <TextBlock Text="{Binding ZoomText}" Classes="caption" Width="46" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Command="{Binding ZoomInCommand}" Theme="{StaticResource ToolButton}" ToolTip.Tip="Zoom in (Ctrl + wheel)"/>
                            <Button Content="100%" Command="{Binding ActualSizeCommand}" Theme="{StaticResource ToolButton}" Margin="6,0,0,0"/>
                            <Button Content="Fit" Click="FitButton_Click" Theme="{StaticResource ToolButton}" Margin="6,0,0,0"/>
                            <Button Content="Save TGA..." Command="{Binding SaveTgaCommand}" Theme="{StaticResource SecondaryButton}" Margin="14,0,0,0" Padding="12,5"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,12,0,0" Background="{DynamicResource PreviewBackground}" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="The texture atlas of the level appears here" Foreground="{DynamicResource PreviewText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasTexture}"/>
                            <ScrollViewer x:Name="PreviewScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasTexture}">
                                <LayoutTransformControl Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <LayoutTransformControl.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                                    </LayoutTransformControl.LayoutTransform>
                                    <Image Source="{Binding TextureSource}" Stretch="None" RenderOptions.BitmapInterpolationMode="None"/>
                                </LayoutTransformControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ status bar ============ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,7">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/>
                <TextBlock Text="Ctrl+O open    Ctrl+E export    drop a level anywhere" Classes="caption" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
