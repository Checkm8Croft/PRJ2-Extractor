<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. Every brush is looked up with DynamicResource, so the theme variant can change while the app runs. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#14161B"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="#1B1E25"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#262B34"/>
    <SolidColorBrush x:Key="CardBackground" Color="#1B1E25"/>
    <SolidColorBrush x:Key="CardBorder" Color="#2B303A"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#3A414D"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E6E8EC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#3F7FF0"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#3068CC"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1E2C48"/>
    <SolidColorBrush x:Key="AccentRing" Color="#2F5DB5"/>
    <SolidColorBrush x:Key="PreviewBackground" Color="#0F1115"/>
    <SolidColorBrush x:Key="PreviewText" Color="#7C8594"/>
    <SolidColorBrush x:Key="HoverFill" Color="#2A2F39"/>
    <SolidColorBrush x:Key="PressedFill" Color="#343A46"/>
    <SolidColorBrush x:Key="LogInfo" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="LogSuccess" Color="#4CC38A"/>
    <SolidColorBrush x:Key="LogWarning" Color="#E0A94A"/>
    <SolidColorBrush x:Key="LogError" Color="#FF6B6B"/>

</ResourceDictionary>
