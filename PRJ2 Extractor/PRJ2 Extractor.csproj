<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>PRJ2_Extractor</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>PRJ2.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- TombLib is built for net6.0-windows, so every call into it is flagged as Windows-only; the port to other systems depends on TombLib itself. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Folder with TombLib.dll and its dependencies; override it with -p:TombEditorDir=... when it is not here (e.g. building from macOS). -->
    <TombEditorDir Condition="'$(TombEditorDir)' == ''">C:\Tomb Editor</TombEditorDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="PRJ2.ico" />
    <AvaloniaResource Include="PRJ2.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>

  <!-- TombLib's NG trigger catalog: needed to split the timer / extra of NG flipeffect and action triggers. -->
  <ItemGroup Condition="Exists('$(TombEditorDir)\Catalogs\NgCatalog.xml')">
    <None Include="$(TombEditorDir)\Catalogs\NgCatalog.xml" Link="Catalogs\NgCatalog.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TombLib">
      <HintPath>$(TombEditorDir)\TombLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AssimpNet">
      <HintPath>$(TombEditorDir)\AssimpNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Blake3">
      <HintPath>$(TombEditorDir)\Blake3.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="bzPSD">
      <HintPath>$(TombEditorDir)\bzPSD.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ColorThief.Netstandard.v20">
      <HintPath>$(TombEditorDir)\ColorThief.Netstandard.v20.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DirectXTexNet">
      <HintPath>$(TombEditorDir)\DirectXTexNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FreeImage.Standard">
      <HintPath>$(TombEditorDir)\FreeImage.Standard.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="K4os.Compression.LZ4">
      <HintPath>$(TombEditorDir)\K4os.Compression.LZ4.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="K4os.Compression.LZ4.Streams">
      <HintPath>$(TombEditorDir)\K4os.Compression.LZ4.Streams.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="K4os.Hash.xxHash">
      <HintPath>$(TombEditorDir)\K4os.Hash.xxHash.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NAudio">
      <HintPath>$(TombEditorDir)\NAudio.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NAudio.Core">
      <HintPath>$(TombEditorDir)\NAudio.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NAudio.Flac">
      <HintPath>$(TombEditorDir)\NAudio.Flac.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NAudio.Vorbis">
      <HintPath>$(TombEditorDir)\NAudio.Vorbis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NAudio.WinMM">
      <HintPath>$(TombEditorDir)\NAudio.WinMM.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NAudio.Wasapi">
      <HintPath>$(TombEditorDir)\NAudio.Wasapi.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NAudio.Asio">
      <HintPath>$(TombEditorDir)\NAudio.Asio.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NAudio.Midi">
      <HintPath>$(TombEditorDir)\NAudio.Midi.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NVorbis">
      <HintPath>$(TombEditorDir)\NVorbis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NLog">
      <HintPath>$(TombEditorDir)\NLog.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Pfim">
      <HintPath>$(TombEditorDir)\Pfim.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.IO.RecyclableMemoryStream">
      <HintPath>$(TombEditorDir)\Microsoft.IO.RecyclableMemoryStream.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.Hashing">
      <HintPath>$(TombEditorDir)\System.IO.Hashing.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(TombEditorDir)\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
